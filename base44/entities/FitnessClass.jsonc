{
  "name": "FitnessClass",
  "type": "object",
  "properties": {
    "name": {
      "type": "string"
    },
    "slug": {
      "type": "string"
    },
    "category": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "difficulty": {
      "type": "string",
      "enum": [
        "Beginner",
        "Intermediate",
        "Advanced",
        "All Levels"
      ]
    },
    "duration_minutes": {
      "type": "number"
    },
    "default_studio": {
      "type": "string",
      "enum": ["aerobics", "spinning", "martial_arts", "floor"]
    },
    "default_access_types": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": ["all", "prepaid", "ladies_only", "kids"]
      }
    },
    "image_url": {
      "type": "string"
    },
    "color": {
      "type": "string"
    },
    "seo_title": {
      "type": "string"
    },
    "seo_description": {
      "type": "string"
    },
    "is_published": {
      "type": "boolean",
      "default": false
    }
  },
  "required": [
    "name",
    "slug",
    "category"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": true,
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}
