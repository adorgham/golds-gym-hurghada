{
  "name": "Booking",
  "type": "object",
  "properties": {
    "trainer_id": {
      "type": "string"
    },
    "trainer_name": {
      "type": "string"
    },
    "preferred_date": {
      "type": "string",
      "format": "date"
    },
    "preferred_time": {
      "type": "string"
    },
    "training_goal": {
      "type": "string"
    },
    "is_member": {
      "type": "boolean",
      "default": false
    },
    "name": {
      "type": "string"
    },
    "phone": {
      "type": "string"
    },
    "whatsapp": {
      "type": "string"
    },
    "email": {
      "type": "string"
    },
    "source_page": {
      "type": "string"
    },
    "utm_source": { "type": "string" },
    "utm_medium": { "type": "string" },
    "utm_campaign": { "type": "string" },
    "utm_term": { "type": "string" },
    "utm_content": { "type": "string" },
    "landing_page": { "type": "string" },
    "referrer": { "type": "string" },
    "status": {
      "type": "string",
      "enum": [
        "New",
        "Contacted",
        "Confirmed",
        "Completed",
        "Cancelled"
      ],
      "default": "New"
    }
  },
  "required": [
    "trainer_name",
    "name",
    "phone"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}
