      "type": "string"
    },
    "title": {
      "type": "string"
    },
    "photo_url": {
      "type": "string"
    },
    "years_experience": {
      "type": "number"
    },
    "certifications": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "languages": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "specializations": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "expertise_areas": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "client_focus": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "training_categories": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "philosophy": {
      "type": "string"
    },
    "bio": {
      "type": "string"
    },
    "availability": {
      "type": "string"
    },
    "instagram_url": {
      "type": "string"
    },
