{
  "name": "Lead",
  "type": "object",
  "properties": {
    "name": {
      "type": "string"
    },
    "email": {
      "type": "string"
    },
    "phone": {
      "type": "string"
    },
    "whatsapp": {
      "type": "string"
    },
    "product": {
      "type": "string"
    },
    "service": {
      "type": "string"
    },
    "trainer": {
      "type": "string"
    },
    "message": {
      "type": "string"
    },
    "source_page": {
      "type": "string"
    },
    "campaign": {
      "type": "string"
    },
    "utm_source": { "type": "string" },
    "utm_medium": { "type": "string" },
    "utm_campaign": { "type": "string" },
    "utm_term": { "type": "string" },
    "utm_content": { "type": "string" },
    "landing_page": { "type": "string" },
    "referrer": { "type": "string" },
    "lead_type": {
      "type": "string",
      "enum": [
        "membership",
        "pass",
        "trainer_booking",
        "contact",
        "tour",
        "callback",
        "whatsapp"
      ]
    },
    "status": {
      "type": "string",
      "enum": [
        "New",
        "Contacted",
        "Qualified",
        "Converted",
        "Lost"
      ],
      "default": "New"
    }
  },
  "required": [
    "name",
    "lead_type"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}
